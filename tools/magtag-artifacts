#!/usr/bin/env bash
set -Eeuo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

# shellcheck source=tools/lib/workbench-env
source "tools/lib/workbench-env"
load_workbench_env PLATFORMIO_ENV

env_name="${PLATFORMIO_ENV:-adafruit_magtag29_esp32s2}"
build_dir=".pio/build/$env_name"
framework_boot_app0=".pio/platformio-core/packages/framework-arduinoespressif32/tools/partitions/boot_app0.bin"

if [[ ! -d "$build_dir" ]]; then
  echo "error: build directory not found: $build_dir" >&2
  echo "Run tools/magtag-build first." >&2
  exit 1
fi

echo "MagTag build artifacts for $env_name"
echo

required=(
  "firmware.bin"
  "firmware.elf"
  "firmware.map"
  "bootloader.bin"
  "partitions.bin"
)

missing=0
for name in "${required[@]}"; do
  path="$build_dir/$name"
  if [[ -f "$path" ]]; then
    printf 'present  %-16s %10s bytes  %s\n' "$name" "$(wc -c <"$path")" "$path"
  else
    printf 'missing  %-16s              %s\n' "$name" "$path"
    missing=1
  fi
done

for name in "firmware.uf2"; do
  path="$build_dir/$name"
  if [[ -f "$path" ]]; then
    printf 'present  %-16s %10s bytes  %s\n' "$name" "$(wc -c <"$path")" "$path"
  else
    printf 'missing  %-16s              %s\n' "$name" "$path"
  fi
done

if [[ -f "$framework_boot_app0" ]]; then
  printf 'present  %-16s %10s bytes  %s\n' "boot_app0.bin" "$(wc -c <"$framework_boot_app0")" "$framework_boot_app0"
else
  printf 'missing  %-16s              %s\n' "boot_app0.bin" "$framework_boot_app0"
  missing=1
fi

echo
echo "App-only flash:"
echo "  tools/espwb-esptool write-flash 0x10000 $build_dir/firmware.bin"
echo
echo "Full flash:"
echo "  tools/espwb-esptool write-flash 0x1000 $build_dir/bootloader.bin 0x8000 $build_dir/partitions.bin 0xe000 $framework_boot_app0 0x10000 $build_dir/firmware.bin"

exit "$missing"
