#!/usr/bin/env bash
set -Eeuo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=tools/lib/workbench-env
source "${SCRIPT_DIR}/lib/workbench-env"
load_workbench_env ESPWB_SSH_KEY ESPWB_SSH_CONNECT_TIMEOUT ESPWB_SSH_SERVER_ALIVE_INTERVAL ESPWB_SSH_SERVER_ALIVE_COUNT_MAX ESPWB_KNOWN_HOSTS

WORKBENCH_IP="${WORKBENCH_IP:-192.0.2.10}"
WORKBENCH_USER="${WORKBENCH_USER:-pi}"
HOST_SSH_DIR="${HOST_SSH_DIR:-/host-ssh}"
SSH_CONFIG="${SSH_CONFIG:-/dev/null}"
ESPWB_SSH_CONNECT_TIMEOUT="${ESPWB_SSH_CONNECT_TIMEOUT:-10}"
ESPWB_SSH_SERVER_ALIVE_INTERVAL="${ESPWB_SSH_SERVER_ALIVE_INTERVAL:-5}"
ESPWB_SSH_SERVER_ALIVE_COUNT_MAX="${ESPWB_SSH_SERVER_ALIVE_COUNT_MAX:-2}"
ESPWB_KNOWN_HOSTS="${ESPWB_KNOWN_HOSTS:-}"

usage() {
  cat <<USAGE
Usage:
  tools/espwb-install-local-esptool

Installs tools/workbench-local-esptool on the configured workbench as:
  /usr/local/bin/espwb-local-esptool
USAGE
}

if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
  usage
  exit 0
fi

if [[ "$#" -ne 0 ]]; then
  usage >&2
  exit 2
fi

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "missing required command: $1" >&2
    exit 1
  }
}

need ssh
need scp
need ssh-keyscan
need mktemp

find_key() {
  if [[ -n "${ESPWB_SSH_KEY:-}" ]]; then
    [[ -r "$ESPWB_SSH_KEY" ]] || {
      echo "ESPWB_SSH_KEY is set but not readable: $ESPWB_SSH_KEY" >&2
      exit 1
    }
    printf '%s\n' "$ESPWB_SSH_KEY"
    return 0
  fi

  local candidate
  for candidate in \
    "$HOST_SSH_DIR/id_ed25519" \
    "$HOST_SSH_DIR/id_ecdsa" \
    "$HOST_SSH_DIR/id_rsa"
  do
    if [[ -r "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  echo "No readable SSH key found under $HOST_SSH_DIR" >&2
  echo "Set ESPWB_SSH_KEY to a readable key path if needed." >&2
  exit 1
}

quote_arg() {
  local s="$1"
  printf "'%s'" "${s//\'/\'\\\'\'}"
}

SOURCE="${SCRIPT_DIR}/workbench-local-esptool"
[[ -x "$SOURCE" ]] || {
  echo "error: missing executable helper: $SOURCE" >&2
  exit 1
}

KEY_SRC="$(find_key)"
TMPDIR_LOCAL="$(mktemp -d)"
TMP_KEY="$TMPDIR_LOCAL/espwb_ssh_key"
KNOWN_HOSTS="$TMPDIR_LOCAL/known_hosts"

cleanup() {
  rm -rf "$TMPDIR_LOCAL"
}
trap cleanup EXIT

cp "$KEY_SRC" "$TMP_KEY"
chmod 0600 "$TMP_KEY"

if [[ -n "$ESPWB_KNOWN_HOSTS" ]]; then
  [[ -r "$ESPWB_KNOWN_HOSTS" ]] || {
    echo "ESPWB_KNOWN_HOSTS is set but not readable: $ESPWB_KNOWN_HOSTS" >&2
    exit 1
  }
  cp "$ESPWB_KNOWN_HOSTS" "$KNOWN_HOSTS"
elif ! ssh-keyscan -T "$ESPWB_SSH_CONNECT_TIMEOUT" "$WORKBENCH_IP" > "$KNOWN_HOSTS" 2>/dev/null; then
  echo "error: could not read SSH host key from $WORKBENCH_IP" >&2
  echo "Set ESPWB_KNOWN_HOSTS to a known_hosts file containing the workbench key if ssh-keyscan is unreliable." >&2
  exit 1
fi

SSH_BASE=(
  ssh
  -i "$TMP_KEY"
  -F "$SSH_CONFIG"
  -o BatchMode=yes
  -o ConnectTimeout="$ESPWB_SSH_CONNECT_TIMEOUT"
  -o ServerAliveInterval="$ESPWB_SSH_SERVER_ALIVE_INTERVAL"
  -o ServerAliveCountMax="$ESPWB_SSH_SERVER_ALIVE_COUNT_MAX"
  -o UserKnownHostsFile="$KNOWN_HOSTS"
  -o StrictHostKeyChecking=yes
)

SCP_BASE=(
  scp
  -i "$TMP_KEY"
  -F "$SSH_CONFIG"
  -o BatchMode=yes
  -o ConnectTimeout="$ESPWB_SSH_CONNECT_TIMEOUT"
  -o ServerAliveInterval="$ESPWB_SSH_SERVER_ALIVE_INTERVAL"
  -o ServerAliveCountMax="$ESPWB_SSH_SERVER_ALIVE_COUNT_MAX"
  -o UserKnownHostsFile="$KNOWN_HOSTS"
  -o StrictHostKeyChecking=yes
)

WB="${WORKBENCH_USER}@${WORKBENCH_IP}"
REMOTE_TMP="/tmp/espwb-local-esptool.$$"

echo "== uploading workbench-local-esptool to ${WB}:${REMOTE_TMP} =="
"${SCP_BASE[@]}" "$SOURCE" "${WB}:${REMOTE_TMP}"

echo "== installing /usr/local/bin/espwb-local-esptool on ${WB} =="
remote_cmd="sudo install -m 0755 $(quote_arg "$REMOTE_TMP") /usr/local/bin/espwb-local-esptool && rm -f $(quote_arg "$REMOTE_TMP")"
"${SSH_BASE[@]}" "$WB" "$remote_cmd"

echo "== installed workbench helper =="
